{
 "_note": "One entry per spoken line. ref = which of the owner's own Chatterbox tone samples is the voice reference. exaggeration/cfg = Chatterbox expressiveness and pacing. pitch = semitones the finished line is raised (formant kept) to move the voice toward the original performer's brighter pitch. gain = dB. gap = silent seconds AFTER the line (the 'listening' beat).",
 "lines": [
  {"id":"L0","scene":"real1","text":"Application received.","ref":"calm","exaggeration":0.25,"cfg":0.6,"pitch":3.0,"gain":0,"gap":0.9,"expr":"deadpan"},
  {"id":"L1","scene":"call","text":"Hello? Yes, this is she.","ref":"warm","exaggeration":0.55,"cfg":0.4,"pitch":5.5,"gain":0,"gap":0.25,"expr":"poised"},
  {"id":"L2","scene":"call","text":"Tomorrow at nine? I'm free.","ref":"warm","exaggeration":0.6,"cfg":0.4,"pitch":5.5,"gain":0,"gap":0.3,"expr":"poised"},
  {"id":"L3","scene":"call","text":"I'm always free.","ref":"calm","exaggeration":0.5,"cfg":0.5,"pitch":5.0,"gain":-5,"gap":0.5,"expr":"whisper"},
  {"id":"L4","scene":"interview","text":"Where do I see myself in five years? Honestly? Your chair.","ref":"energetic","exaggeration":0.9,"cfg":0.3,"pitch":6.0,"gain":0,"gap":0.2,"expr":"cheeky"},
  {"id":"L5","scene":"interview","text":"Ha! I'm kidding. Mostly.","ref":"energetic","exaggeration":0.9,"cfg":0.3,"pitch":6.0,"gain":0,"gap":0.9,"expr":"laugh"},
  {"id":"L6","scene":"interview","text":"Monday? You're sure? Oh, you're so kind.","ref":"expressive","exaggeration":1.0,"cfg":0.3,"pitch":6.5,"gain":0,"gap":0.3,"expr":"shocked"},
  {"id":"L7","scene":"dayone","text":"Hi! I'm so happy to be here. I brought snacks for everyone.","ref":"energetic","exaggeration":0.95,"cfg":0.3,"pitch":6.5,"gain":0,"gap":0.2,"expr":"beam"},
  {"id":"L8","scene":"dayone","text":"Dana already loves me.","ref":"calm","exaggeration":0.5,"cfg":0.5,"pitch":5.0,"gain":-5,"gap":0.5,"expr":"whisper"},
  {"id":"L9","scene":"dayone","text":"No, I don't mind staying late. I love staying late.","ref":"expressive","exaggeration":0.95,"cfg":0.3,"pitch":6.5,"gain":0,"gap":0.5,"expr":"beam"},
  {"id":"L10","scene":"payday","text":"Okay, don't panic. I'm just going to treat myself. A little treat. A tiny apartment with a balcony.","ref":"expressive","exaggeration":1.0,"cfg":0.3,"pitch":6.5,"gain":0,"gap":0.5,"expr":"gasp"},
  {"id":"L11","scene":"promo","text":"Manager? After two weeks? No, no, it's too much.","ref":"expressive","exaggeration":1.0,"cfg":0.3,"pitch":6.5,"gain":0,"gap":0.7,"expr":"shocked"},
  {"id":"L12","scene":"promo","text":"Okay. Fine.","ref":"warm","exaggeration":0.7,"cfg":0.4,"pitch":6.0,"gain":0,"gap":0.9,"expr":"smug"},
  {"id":"L13","scene":"promo","text":"I'd like to thank the application I submitted four seconds ago.","ref":"warm","exaggeration":0.8,"cfg":0.4,"pitch":6.0,"gain":0,"gap":0.6,"expr":"proud"},
  {"id":"L14","scene":"promo","text":"Dana, don't cry, you're making me cry.","ref":"upset","exaggeration":1.0,"cfg":0.3,"pitch":6.5,"gain":0,"gap":0.4,"expr":"teary"}
 ]
}
